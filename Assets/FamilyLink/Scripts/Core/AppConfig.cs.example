//서버 주소 등 상수값들
public static class AppConfig
{
    // --- [백엔드 서버 주소 설정] ---
    public const string BaseUrl = "http://localhost:4000"; 

    // --- [API 경로] ---
    public const string AuthApi = BaseUrl + "/api/auth";
    public const string RegisterUrl = AuthApi + "/register";
    public const string LoginUrl = AuthApi + "/login";
    public const string AgoraUrl = BaseUrl + "/api/agora";
    public const string RoomsUrl = BaseUrl + "/api/rooms";
    public const string SongUrl = BaseUrl + "/api/songs?q=";
    public const string FriendListUrl = BaseUrl + "/api/friends/list";
    public const string FriendStatusesUrl = BaseUrl + "/api/friends/statuses";
    public const string STTUrl = BaseUrl + "/api/ai/transcribe";

    // --- [소켓 경로] ---
    public const string SocketUrl = BaseUrl;

    // --- [Ubiq P2P 포트] ---
    public const int UbiqPort = 8009;

    // --- [Agora App ID] ---
    public const string AgoraAppID = "your-app-id-here";
    public const string AGORA_APP_CERTIFICATE = "your-app-certificate-here";
    public const float AgoraOffsetSec = 0.15f;

    // --- [Youtube API] ---
    public const string YoutubeAPI = "your-youtube-api-key-here";
}